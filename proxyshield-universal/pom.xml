<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.lucasthcr.bridgesave</groupId>
        <artifactId>proxyshield-parent</artifactId>
        <version>3.0.1-BETA</version>
    </parent>

    <artifactId>proxyshield-universal</artifactId>
    <name>ProxyShield Universal</name>
    <description>
        One jar for every platform. It carries all four entry points and all four descriptors;
        each server reads the one it knows and ignores the rest. The sources are the platform
        modules' own, added rather than copied, so this build can never drift from them.
    </description>

    <dependencies>
        <dependency>
            <groupId>de.lucasthcr.bridgesave</groupId>
            <artifactId>proxyshield-common</artifactId>
        </dependency>

        <!-- Every server API at once. All provided: the host supplies its own at runtime. -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
        </dependency>
        <dependency>
            <groupId>net.md-5</groupId>
            <artifactId>bungeecord-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.velocitypowered</groupId>
            <artifactId>velocity-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.spongepowered</groupId>
            <artifactId>spongeapi</artifactId>
        </dependency>
        <dependency>
            <groupId>me.clip</groupId>
            <artifactId>placeholderapi</artifactId>
        </dependency>

        <!--
          One bStats artifact per platform. They share bstats-base and add nothing but their own
          Metrics class, so bundling all four costs four classes.
        -->
        <dependency>
            <groupId>org.bstats</groupId>
            <artifactId>bstats-bukkit</artifactId>
        </dependency>
        <dependency>
            <groupId>org.bstats</groupId>
            <artifactId>bstats-bungeecord</artifactId>
        </dependency>
        <dependency>
            <groupId>org.bstats</groupId>
            <artifactId>bstats-velocity</artifactId>
        </dependency>
        <dependency>
            <groupId>org.bstats</groupId>
            <artifactId>bstats-sponge</artifactId>
        </dependency>

        <!-- Velocity and Sponge expose no SnakeYAML, so the parser ships with the plugin. -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>ProxyShield-Universal-${project.version}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <!--
              The platform sources are added, not duplicated. A fix in proxyshield-paper lands in
              this jar the same build it lands in the Paper one.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>add-platform-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.basedir}/../proxyshield-paper/src/main/java</source>
                                <source>${project.basedir}/../proxyshield-bungee/src/main/java</source>
                                <source>${project.basedir}/../proxyshield-velocity/src/main/java</source>
                                <source>${project.basedir}/../proxyshield-sponge/src/main/java</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- Writes velocity-plugin.json from the @Plugin annotation on VelocityMain. -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>com.velocitypowered</groupId>
                            <artifactId>velocity-api</artifactId>
                            <version>${velocity.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <artifactSet>
                                <includes>
                                    <include>de.lucasthcr.bridgesave:proxyshield-common</include>
                                    <include>org.yaml:snakeyaml</include>
                                    <include>org.bstats:*</include>
                                </includes>
                            </artifactSet>
                            <relocations>
                                <!--
                                  bStats requires relocation: two plugins shipping the same
                                  unrelocated copy fight over one class on a shared classpath.
                                -->
                                <relocation>
                                    <pattern>org.bstats</pattern>
                                    <shadedPattern>de.lucasthcr.bridgesave.proxyshield.bstats</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.yaml.snakeyaml</pattern>
                                    <shadedPattern>de.lucasthcr.bridgesave.proxyshield.libs.snakeyaml</shadedPattern>
                                </relocation>
                            </relocations>
                            <filters>
                                <filter>
                                    <artifact>org.yaml:snakeyaml</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/versions/**</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
