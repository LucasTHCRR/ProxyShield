<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.lucasthcr.bridgesave</groupId>
        <artifactId>proxyshield-parent</artifactId>
        <version>3.1.0-RELEASE</version>
    </parent>

    <artifactId>proxyshield-common</artifactId>
    <name>ProxyShield Common</name>
    <description>Platform independent detection core.</description>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
    </properties>

    <dependencies>
        <!-- Update checks. Shaded and relocated by every platform jar; Gson comes with the server. -->
        <dependency>
            <groupId>dev.paperstream</groupId>
            <artifactId>updater-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
        </dependency>
        <!--
          YamlConfigNode compiles against this; the platforms that use it shade their own copy.
          Provided scope is also on the test classpath, which is what lets the tests parse the
          real bundled config.yml and message files.
        -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          A real database for the SQL storage tests. Test scope only: the plugin ships no JDBC
          driver, it uses whichever one the server already has.
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.2.224</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
